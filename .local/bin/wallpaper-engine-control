#!/usr/bin/env python3
"""Control Linux Wallpaper Engine from the desktop bar.

Actions
  status          read-only snapshot; never writes anything
  pause / resume / toggle
                  "native pause": one hidden fullscreen zenity window on a
                  private special workspace makes linux-wallpaperengine's own
                  fullscreen detector stop rendering. SIGSTOP is deliberately
                  not used: queued DBus/MPRIS events can crash the renderer
                  on resume.
  next            SIGUSR1 to every playlist renderer -> advance one wallpaper
                  (needs the patched build from ~/.config/linux-wallpaperengine-pkg)
  stop / start / power-toggle
                  kill or relaunch the whole Electron UX to release GPU memory

Only `power.json` (the restore plan written by `stop`) is persisted, under
$XDG_RUNTIME_DIR/wallpaper-engine-control/. The UX log of the last `start`
lives next to it as `ux.log`.
"""

from __future__ import annotations

import argparse
import ctypes
import fcntl
import json
import os
import random
import re
import shutil
import signal
import stat
import subprocess
import sys
import time
import uuid
from collections.abc import Callable, Iterator
from contextlib import contextmanager
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

PROCESS_NAME = "linux-wallpaperengine"
RENDERER_EXECUTABLE = "/opt/linux-wallpaperengine/linux-wallpaperengine"
NEXT_SUPPORT_MARKER = Path("/opt/linux-wallpaperengine/.supports-sigusr1-advance")
UX_EXECUTABLE = "/usr/lib/electron39/electron"
UX_ASAR = "/usr/lib/linux-wallpaper-engine-ux/app.asar"
UX_COMMAND = "/usr/bin/linux-wallpaper-engine-ux"
ACTIVE_WALLPAPERS_PATH = Path.home() / ".config/Linux Wallpaper Engine/active-wallpapers.json"
STEAM_ROOTS = (
    Path.home() / ".local/share/Steam",
    Path.home() / ".steam/steam",
    Path.home() / ".var/app/com.valvesoftware.Steam/.local/share/Steam",
    Path.home() / ".var/app/com.valvesoftware.Steam/.data/Steam",
    Path.home() / ".var/app/com.valvesoftware.Steam/.steam/steam",
)
STEAM_CONFIG_RELATIVE = Path("steamapps/common/wallpaper_engine/config.json")
STEAM_LIBRARY_PATH_PATTERN = re.compile(r'"path"\s+"([^"]+)"')
HELPER_PROGRAM = "zenity"
HELPER_TITLE_PREFIX = "EVA Wallpaper Pause Helper"
HELPER_WORKSPACE = "special:eva-wallpaper-pause"
RUNTIME_ROOT = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "wallpaper-engine-control"
POWER_STATE_PATH = RUNTIME_ROOT / "power.json"
UX_LOG_PATH = RUNTIME_ROOT / "ux.log"
LOCK_PATH = RUNTIME_ROOT / "control.lock"
SELECTION_KEYS = ("activeWallpapers", "activePlaylists", "activePlaylist")
AT_FDCWD = -100
RENAME_EXCHANGE = 2


class ControlError(RuntimeError):
    """A user-facing control failure."""


# --------------------------------------------------------------------------- processes


@dataclass
class Proc:
    pid: int
    argv: list[str]
    exe: str  # readlink of /proc/pid/exe, "(deleted)" suffix stripped
    exe_replaced: bool  # binary on disk changed since the process started
    start_time: int  # procfs stat field 22


@dataclass
class Renderer(Proc):
    screens: list[str] = field(default_factory=list)
    playlists: dict[str, str] = field(default_factory=dict)  # screen -> playlist name
    backgrounds: dict[str, str] = field(default_factory=dict)  # screen -> background id
    default_playlist: str | None = None  # window mode: --playlist without a screen selector


def proc_argv(pid: int) -> list[str]:
    raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    return [os.fsdecode(part) for part in raw.split(b"\0") if part]


def proc_stat_fields(pid: int) -> list[str]:
    # Fields start at procfs field 3 because PID and comm precede the final ')'.
    return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].strip().split()


def proc_start_time(pid: int) -> int:
    return int(proc_stat_fields(pid)[19])


def own_processes() -> Iterator[Proc]:
    uid = os.getuid()
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != uid:
                continue
            pid = int(entry.name)
            argv = proc_argv(pid)
            exe = os.readlink(f"/proc/{pid}/exe")
            start_time = proc_start_time(pid)
        except OSError, IndexError, ValueError:
            continue
        if not argv:
            continue
        replaced = exe.endswith(" (deleted)")
        yield Proc(pid, argv, exe.removesuffix(" (deleted)"), replaced, start_time)


def parse_renderer_argv(argv: list[str]) -> tuple[list[str], dict[str, str], dict[str, str], str | None]:
    """Return screen bindings and the renderer-level window-mode playlist."""
    screens: list[str] = []
    playlists: dict[str, str] = {}
    backgrounds: dict[str, str] = {}
    default_playlist: str | None = None
    current: list[str] = []
    for index, argument in enumerate(argv[:-1]):
        value = argv[index + 1]
        if argument == "--screen-root":
            current = [value]
            screens.append(value)
        elif argument == "--screen-span":
            current = [screen for screen in value.split(",") if screen]
            screens.extend(current)
        elif argument == "--playlist":
            if current:
                for screen in current:
                    playlists[screen] = value
            else:
                default_playlist = value
        elif argument == "--bg":
            for screen in current:
                backgrounds[screen] = value
    return sorted(set(screens)), playlists, backgrounds, default_playlist


def renderers() -> list[Renderer]:
    found: list[Renderer] = []
    for proc in own_processes():
        if Path(proc.argv[0]).name != PROCESS_NAME or proc.exe != RENDERER_EXECUTABLE:
            continue
        if any(argument.startswith("--type=") for argument in proc.argv):
            continue  # CEF helper subprocess
        screens, playlists, backgrounds, default_playlist = parse_renderer_argv(proc.argv)
        found.append(
            Renderer(
                proc.pid,
                proc.argv,
                proc.exe,
                proc.exe_replaced,
                proc.start_time,
                screens,
                playlists,
                backgrounds,
                default_playlist,
            )
        )
    return sorted(found, key=lambda renderer: renderer.pid)


def ux_processes() -> list[Proc]:
    return sorted(
        (
            proc
            for proc in own_processes()
            if proc.argv == [UX_EXECUTABLE, UX_ASAR] and proc.exe == UX_EXECUTABLE and not proc.exe_replaced
        ),
        key=lambda proc: proc.pid,
    )


def ux_pids() -> list[int]:
    return [proc.pid for proc in ux_processes()]


def process_identity_live(proc: Proc) -> bool:
    try:
        return (
            Path(f"/proc/{proc.pid}").stat().st_uid == os.getuid()
            and proc_start_time(proc.pid) == proc.start_time
            and proc_argv(proc.pid) == proc.argv
            and os.readlink(f"/proc/{proc.pid}/exe").removesuffix(" (deleted)") == proc.exe
            and proc_stat_fields(proc.pid)[0] != "Z"
        )
    except OSError, IndexError, ValueError:
        return False


def signal_mask_contains(mask: str, requested_signal: signal.Signals) -> bool:
    try:
        return bool(int(mask, 16) & (1 << (int(requested_signal) - 1)))
    except ValueError:
        return False


def renderer_next_ready(renderer: Renderer) -> bool:
    """True once SIGUSR1 is blocked or caught by this exact renderer process."""
    if not process_identity_live(renderer):
        return False
    try:
        fields = {
            key: value.strip()
            for line in Path(f"/proc/{renderer.pid}/status").read_text().splitlines()
            if ":" in line
            for key, value in [line.split(":", 1)]
        }
    except OSError:
        return False
    return signal_mask_contains(fields.get("SigBlk", ""), signal.SIGUSR1) or signal_mask_contains(
        fields.get("SigCgt", ""), signal.SIGUSR1
    )


def signal_process(proc: Proc, requested_signal: signal.Signals) -> bool:
    """Signal one exact process identity; a reused numeric PID is never targeted."""
    try:
        pidfd = os.pidfd_open(proc.pid)
    except ProcessLookupError:
        return False
    try:
        if not process_identity_live(proc):
            return False
        try:
            signal.pidfd_send_signal(pidfd, requested_signal)
        except ProcessLookupError:
            return False
        return True
    finally:
        os.close(pidfd)


def kill_and_wait(proc: Proc, label: str, grace: float = 3.0) -> None:
    for requested_signal, timeout in ((signal.SIGTERM, grace), (signal.SIGKILL, 1.0)):
        if not process_identity_live(proc):
            return
        signal_process(proc, requested_signal)
        deadline = time.monotonic() + timeout
        while process_identity_live(proc) and time.monotonic() < deadline:
            time.sleep(0.05)
    if process_identity_live(proc):
        raise ControlError(f"{label} PID {proc.pid} did not exit")


def wait_until(predicate: Callable[[], bool], timeout: float, interval: float = 0.1) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if predicate():
            return True
        time.sleep(interval)
    return predicate()


def run(command: list[str], timeout: float = 5) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(command, check=False, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ControlError(f"{command[0]} failed: {error}") from error


# --------------------------------------------------------------------------- config files


def read_json_object(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as error:
        raise ControlError(f"{path.name} is invalid JSON") from error
    if not isinstance(value, dict):
        raise ControlError(f"{path.name} must contain a JSON object")
    return value


def write_json_atomic(path: Path, value: Any, indent: str | int | None, mode: int = 0o600) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        existing = os.stat(path, follow_symlinks=False)
    except FileNotFoundError:
        existing = None
    except OSError as error:
        raise ControlError(f"cannot inspect {path}: {error}") from error
    if existing is not None:
        if not stat.S_ISREG(existing.st_mode) or existing.st_uid != os.getuid():
            raise ControlError(f"refusing to replace a non-regular or foreign-owned file: {path}")
        mode = stat.S_IMODE(existing.st_mode)

    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}-{uuid.uuid4().hex}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    try:
        descriptor = os.open(temporary, flags, 0o600)
        with os.fdopen(descriptor, "w") as handle:
            os.fchmod(handle.fileno(), mode)
            json.dump(value, handle, indent=indent, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError as error:
        raise ControlError(f"cannot atomically write {path}: {error}") from error
    finally:
        temporary.unlink(missing_ok=True)


def read_active_config() -> dict[str, Any]:
    return read_json_object(ACTIVE_WALLPAPERS_PATH)


def selection(config: dict[str, Any]) -> dict[str, Any]:
    return {key: config.get(key) for key in SELECTION_KEYS}


def selection_is_empty(config: dict[str, Any]) -> bool:
    return not any(selection(config).values())


def active_screens(config: dict[str, Any]) -> list[str]:
    screens: set[str] = set()
    for key in ("activeWallpapers", "activePlaylists"):
        section = config.get(key)
        if isinstance(section, dict):
            screens.update(str(screen) for screen in section if screen)
    legacy = config.get("activePlaylist")
    if isinstance(legacy, dict) and isinstance(legacy.get("screen"), str):
        screens.add(legacy["screen"])
    return sorted(screens)


def active_playlist_names(config: dict[str, Any]) -> set[str]:
    names: set[str] = set()
    entries = config.get("activePlaylists")
    active_entries = entries if isinstance(entries, dict) else {}
    for entry in active_entries.values():
        if isinstance(entry, dict) and isinstance(entry.get("name"), str) and entry["name"]:
            names.add(entry["name"])
    legacy = config.get("activePlaylist")
    if isinstance(legacy, dict):
        screen = legacy.get("screen")
        name = legacy.get("name")
        if isinstance(screen, str) and screen not in active_entries and isinstance(name, str) and name:
            names.add(name)
    return names


def restore_config_for_stop(records: list[Renderer], active_config: dict[str, Any]) -> dict[str, Any]:
    """Return a full, topology-matched restore document or fail before killing anything."""
    live_screens = {screen for renderer in records for screen in renderer.screens}
    if not live_screens:
        raise ControlError("running renderers do not identify any outputs; refusing destructive stop")

    if not selection_is_empty(active_config):
        configured = set(active_screens(active_config))
        if configured != live_screens:
            raise ControlError(
                f"active restore plan does not match live outputs: configured={sorted(configured)} "
                f"live={sorted(live_screens)}"
            )
        return active_config

    saved = read_power_state()
    if not isinstance(saved, dict):
        raise ControlError("active selection is empty and no trustworthy restore plan exists")
    saved_config = saved.get("active_config")
    saved_expected = saved.get("expected_screens")
    if not isinstance(saved_config, dict) or selection_is_empty(saved_config) or not isinstance(saved_expected, list):
        raise ControlError("active selection is empty and no trustworthy restore plan exists")
    expected = {str(screen) for screen in saved_expected if screen}
    configured = set(active_screens(saved_config))
    if expected != live_screens or configured != live_screens:
        raise ControlError(
            f"saved restore plan does not match live outputs: saved={sorted(expected)} configured={sorted(configured)} "
            f"live={sorted(live_screens)}"
        )
    return saved_config


def read_power_state() -> dict[str, Any] | None:
    try:
        state = read_json_object(POWER_STATE_PATH)
    except ControlError:
        return None
    return state or None


def write_power_state(expected_screens: list[str], active_config: dict[str, Any]) -> None:
    write_json_atomic(
        POWER_STATE_PATH,
        {"expected_screens": sorted(set(expected_screens)), "active_config": active_config},
        indent=None,
    )


# --------------------------------------------------------------------------- Steam playlist shuffle
# The UX shuffles a random playlist only when it is applied from its own UI; the
# restart-on-launch path keeps the stored order, so a fresh start would replay the
# same first wallpaper. Reorder random playlists in Steam's config.json before launch.


def steam_library_paths() -> list[Path]:
    libraries: list[Path] = []
    seen: set[str] = set()

    def add(path: Path) -> None:
        key = os.fspath(path)
        if path.is_absolute() and key not in seen:
            seen.add(key)
            libraries.append(path)

    for root in STEAM_ROOTS:
        add(root)
        try:
            folders = (root / "steamapps/libraryfolders.vdf").read_text()
        except OSError:
            continue
        for match in STEAM_LIBRARY_PATH_PATTERN.finditer(folders):
            add(Path(match.group(1).replace("\\\\", "\\")))
    return libraries


def steam_config_path() -> Path:
    for root in steam_library_paths():
        candidate = root / STEAM_CONFIG_RELATIVE
        try:
            if not candidate.exists():
                continue
            resolved = candidate.resolve(strict=True)
            status = resolved.stat()
        except OSError as error:
            raise ControlError(f"cannot inspect Wallpaper Engine config {candidate}: {error}") from error
        if not stat.S_ISREG(status.st_mode) or status.st_uid != os.getuid():
            raise ControlError(f"Wallpaper Engine config is not an owner-controlled regular file: {resolved}")
        if not status.st_mode & stat.S_IWUSR or not os.access(resolved, os.R_OK | os.W_OK):
            raise ControlError(f"Wallpaper Engine config is not owner-readable and writable: {resolved}")
        return resolved
    raise ControlError("could not find Wallpaper Engine's config.json in any Steam library")


def _file_identity(status: os.stat_result) -> tuple[int, int, int, int]:
    return (status.st_dev, status.st_ino, status.st_size, status.st_mtime_ns)


def _read_file_snapshot(path: Path) -> tuple[bytes, tuple[int, int, int, int], int, int]:
    flags = os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    try:
        descriptor = os.open(path, flags)
        with os.fdopen(descriptor, "rb") as handle:
            before = os.fstat(handle.fileno())
            if not stat.S_ISREG(before.st_mode):
                raise ControlError(f"Wallpaper Engine config is not a regular file: {path}")
            raw = handle.read()
            after = os.fstat(handle.fileno())
        path_status = os.stat(path, follow_symlinks=False)
    except ControlError:
        raise
    except OSError as error:
        raise ControlError(f"cannot read Wallpaper Engine playlist config: {error}") from error
    identity = _file_identity(before)
    if identity != _file_identity(after) or identity != _file_identity(path_status):
        raise ControlError("Wallpaper Engine playlist config changed while it was being read")
    return raw, identity, stat.S_IMODE(after.st_mode), after.st_uid


def read_steam_config(path: Path) -> tuple[dict[str, Any], bytes, tuple[int, int, int, int], int]:
    raw, identity, mode, owner = _read_file_snapshot(path)
    if owner != os.getuid() or not mode & stat.S_IWUSR:
        raise ControlError("refusing to modify a foreign-owned or owner-read-only Wallpaper Engine config")
    try:
        config = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ControlError("Wallpaper Engine config.json is invalid") from error
    if not isinstance(config, dict):
        raise ControlError("Wallpaper Engine config.json must contain an object")
    return config, raw, identity, mode


def _write_sibling_temp(path: Path, label: str, payload: bytes, mode: int) -> Path:
    temporary = path.with_name(f".{path.name}.{label}-{os.getpid()}-{uuid.uuid4().hex}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    try:
        descriptor = os.open(temporary, flags, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            os.fchmod(handle.fileno(), mode)
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
    except OSError as error:
        temporary.unlink(missing_ok=True)
        raise ControlError(f"cannot prepare Wallpaper Engine config update: {error}") from error
    return temporary


def _exchange_paths(source: Path, target: Path) -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise ControlError("renameat2(RENAME_EXCHANGE) is unavailable; refusing a non-atomic config update")
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    if renameat2(AT_FDCWD, os.fsencode(source), AT_FDCWD, os.fsencode(target), RENAME_EXCHANGE) != 0:
        error_number = ctypes.get_errno()
        raise ControlError(f"cannot atomically exchange Wallpaper Engine config: {os.strerror(error_number)}")


def _restore_exchanged_path(
    source: Path,
    target: Path,
    committed_raw: bytes,
    committed_identity: tuple[int, int, int, int],
    restore_raw: bytes,
) -> None:
    current_raw, current_identity, _, _ = _read_file_snapshot(target)
    if current_identity != committed_identity or current_raw != committed_raw:
        raise ControlError(f"config changed after exchange; recovery copy retained at {source}")
    _exchange_paths(source, target)
    restored_raw, _, _, _ = _read_file_snapshot(target)
    if restored_raw != restore_raw:
        raise ControlError(f"config rollback verification failed; recovery copy retained at {source}")


def _safe_private_unlink(path: Path) -> None:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            os.fchmod(descriptor, 0o600)
        finally:
            os.close(descriptor)
        path.unlink()
    except OSError:
        pass


def write_steam_config(
    path: Path,
    config: dict[str, Any],
    expected_raw: bytes,
    expected_identity: tuple[int, int, int, int],
    mode: int,
) -> None:
    payload = (json.dumps(config, indent=2, ensure_ascii=False) + "\n").encode()
    backup = path.with_name(f"{path.name}.eva-wallpaper-control.backup")
    backup_temporary = _write_sibling_temp(path, "eva-backup-tmp", expected_raw, 0o600)
    temporary = _write_sibling_temp(path, "eva-tmp", payload, mode)
    temporary_identity = _file_identity(temporary.stat())
    preserve_temporary = False
    exchanged = False
    try:
        current_raw, current_identity, _, current_owner = _read_file_snapshot(path)
        if current_owner != os.getuid() or current_identity != expected_identity or current_raw != expected_raw:
            raise ControlError("Wallpaper Engine playlist config changed before the shuffle could be saved")

        _exchange_paths(temporary, path)
        exchanged = True
        captured_raw, captured_identity, _, _ = _read_file_snapshot(temporary)
        committed_raw, committed_identity, _, _ = _read_file_snapshot(path)
        if captured_identity != expected_identity or captured_raw != expected_raw:
            try:
                _restore_exchanged_path(temporary, path, committed_raw, committed_identity, captured_raw)
                exchanged = False
            except ControlError:
                preserve_temporary = True
                raise
            raise ControlError("Wallpaper Engine playlist config changed at the atomic commit boundary")
        if committed_identity != temporary_identity or committed_raw != payload:
            preserve_temporary = True
            raise ControlError(f"config changed after exchange; recovery copy retained at {temporary}")

        try:
            os.replace(backup_temporary, backup)
        except OSError as error:
            try:
                _restore_exchanged_path(temporary, path, payload, temporary_identity, expected_raw)
                exchanged = False
            except ControlError:
                preserve_temporary = True
                raise
            raise ControlError(f"cannot publish Wallpaper Engine config backup: {error}") from error
        exchanged = False
    finally:
        if not preserve_temporary:
            _safe_private_unlink(temporary)
        _safe_private_unlink(backup_temporary)
        if exchanged:
            # The exchanged file intentionally remains as a private recovery copy.
            os.chmod(temporary, 0o600, follow_symlinks=False)


def shuffled_items(items: list[str], rng: random.Random) -> list[str]:
    shuffled = list(items)
    rng.shuffle(shuffled)
    if shuffled[0] == items[0]:  # make the restart visibly change the wallpaper
        for index, item in enumerate(shuffled):
            if item != items[0]:
                shuffled[0], shuffled[index] = shuffled[index], shuffled[0]
                break
    return shuffled


def shuffle_random_playlists(names: set[str], rng: random.Random | None = None) -> list[str]:
    if not names:
        return []
    path = steam_config_path()
    config, raw, identity, mode = read_steam_config(path)
    playlists = config.get("steamuser", {}).get("general", {}).get("playlists")
    if not isinstance(playlists, list):
        raise ControlError(f"{path} has no playlist list")
    rng = rng or random.SystemRandom()
    matching: dict[str, dict[str, Any]] = {}
    duplicates: set[str] = set()
    for playlist in playlists:
        if not isinstance(playlist, dict) or not isinstance(playlist.get("name"), str):
            continue
        name = playlist["name"]
        if name not in names:
            continue
        if name in matching:
            duplicates.add(name)
        matching[name] = playlist
    if duplicates:
        raise ControlError(f"active playlist names are duplicated: {', '.join(sorted(duplicates))}")
    missing = sorted(names - set(matching))
    if missing:
        raise ControlError(f"active playlists are missing from config.json: {', '.join(missing)}")

    shuffled: list[str] = []
    for name in sorted(names):
        playlist = matching[name]
        settings = playlist.get("settings")
        items = playlist.get("items")
        if not isinstance(settings, dict) or settings.get("order") != "random":
            continue
        if not isinstance(items, list) or not all(isinstance(item, str) for item in items):
            raise ControlError(f"random playlist {name} has an invalid item list")
        if len(items) <= 1 or not any(item != items[0] for item in items[1:]):
            continue
        playlist["items"] = shuffled_items(items, rng)
        shuffled.append(name)
    if shuffled:
        write_steam_config(path, config, raw, identity, mode)
    return shuffled


# --------------------------------------------------------------------------- pause helper


def hyprland_clients() -> list[dict[str, Any]]:
    result = run(["hyprctl", "clients", "-j"], timeout=3)
    if result.returncode != 0:
        raise ControlError(f"hyprctl clients failed: {result.stderr.strip() or result.returncode}")
    try:
        clients = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise ControlError("hyprctl returned invalid JSON") from error
    return clients if isinstance(clients, list) else []


def helper_windows() -> list[dict[str, Any]]:
    """Every pause helper window we own: {pid, title, argv, native_pause}."""
    helpers: list[dict[str, Any]] = []
    processes = {proc.pid: proc for proc in own_processes()}
    for client in hyprland_clients():
        title = str(client.get("title", ""))
        if client.get("class") != HELPER_PROGRAM or not title.startswith(f"{HELPER_TITLE_PREFIX} "):
            continue
        try:
            pid = int(client["pid"])
            process = processes[pid]
        except KeyError, ValueError:
            continue
        if Path(process.argv[0]).name != HELPER_PROGRAM or f"--title={title}" not in process.argv:
            continue
        workspace = client.get("workspace") or {}
        native = workspace.get("name") == HELPER_WORKSPACE and int(client.get("fullscreen") or 0) != 0
        helpers.append({"pid": pid, "title": title, "argv": process.argv, "process": process, "native_pause": native})
    return helpers


def fullscreen_windows() -> list[str]:
    windows: list[str] = []
    for client in hyprland_clients():
        try:
            fullscreen = int(client.get("fullscreen") or 0)
        except TypeError, ValueError:
            fullscreen = 0
        if fullscreen:
            windows.append(str(client.get("title") or client.get("class") or "unknown window"))
    return windows


def resume() -> dict[str, Any]:
    for helper in helper_windows():
        kill_and_wait(helper["process"], "pause helper")
    if not wait_until(lambda: not helper_windows(), timeout=2):
        raise ControlError("pause helper window remained after its process exited")
    return snapshot()


def pause() -> dict[str, Any]:
    records = renderers()
    if not records:
        raise ControlError("no linux-wallpaperengine renderers are running")
    incompatible = [r.pid for r in records if {"--no-fullscreen-pause", "--fullscreen-pause-only-active"} & set(r.argv)]
    if incompatible:
        raise ControlError(f"native fullscreen pausing is disabled for renderer PID(s): {incompatible}")

    helpers = helper_windows()
    if helpers and all(h["native_pause"] for h in helpers):
        return snapshot()
    for helper in helpers:  # half-mapped or misplaced helper: replace it
        kill_and_wait(helper["process"], "pause helper")

    executable = shutil.which(HELPER_PROGRAM)
    if executable is None:
        raise ControlError("zenity is required for the hidden native-pause helper")
    title = f"{HELPER_TITLE_PREFIX} {uuid.uuid4().hex[:12]}"
    process = subprocess.Popen(
        [executable, "--info", f"--title={title}", "--text=Wallpaper rendering is paused", "--no-wrap"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

    def mapped() -> bool:
        if process.poll() is not None:
            raise ControlError("native-pause helper exited before it became ready")
        return any(h["pid"] == process.pid and h["native_pause"] for h in helper_windows())

    try:
        if not wait_until(mapped, timeout=5, interval=0.05):
            raise ControlError(
                f"native-pause helper did not become fullscreen on {HELPER_WORKSPACE}; check the Hyprland window rule"
            )
    except ControlError:
        if process.poll() is None:
            process.kill()
            process.wait(timeout=2)
        raise
    return snapshot()


def toggle() -> dict[str, Any]:
    return resume() if helper_windows() else pause()


# --------------------------------------------------------------------------- next wallpaper


def next_wallpaper() -> dict[str, Any]:
    records = renderers()
    if not records:
        raise ControlError("no linux-wallpaperengine renderers are running")
    if helper_windows():
        raise ControlError("wallpapers are paused; resume before skipping")
    fullscreen = fullscreen_windows()
    if fullscreen:
        raise ControlError(f"a fullscreen window is active; leave fullscreen before skipping: {fullscreen}")
    targets = [renderer for renderer in records if renderer.playlists or renderer.default_playlist]
    if not targets:
        raise ControlError("no renderer is playing a playlist")
    if not NEXT_SUPPORT_MARKER.exists():
        raise ControlError(
            "installed linux-wallpaperengine lacks the SIGUSR1 playlist patch (~/.config/linux-wallpaperengine-pkg)"
        )
    replaced = [renderer.pid for renderer in targets if renderer.exe_replaced]
    unready = [renderer.pid for renderer in targets if not renderer_next_ready(renderer)]
    if replaced:
        raise ControlError(
            f"renderer binary was upgraded after PID(s) {replaced} started; power-toggle twice to restart"
        )
    if unready:
        raise ControlError(f"renderer Next handler is not ready for PID(s) {unready}")

    requested: list[Renderer] = []
    vanished: list[int] = []
    for renderer in targets:
        if signal_process(renderer, signal.SIGUSR1):
            requested.append(renderer)
        else:
            vanished.append(renderer.pid)
    if vanished:
        detail = f"renderer PID(s) {vanished} vanished before Next could be requested"
        if requested:
            detail += f"; request was already sent to PID(s) {[renderer.pid for renderer in requested]}"
        raise ControlError(detail)

    result = snapshot()
    # SIGUSR1 is fire-and-forget; say requested, never claim an unacknowledged advance.
    result["requested_pids"] = [renderer.pid for renderer in requested]
    result["requested_screens"] = sorted({screen for renderer in requested for screen in renderer.playlists})
    return result


# --------------------------------------------------------------------------- stop / start


def proc_cgroup(pid: int) -> str:
    for line in Path(f"/proc/{pid}/cgroup").read_text().splitlines():
        if line.startswith("0::"):
            return line[3:]
    raise ControlError(f"cannot resolve cgroup v2 path for PID {pid}")


def descendants(pid: int) -> list[int]:
    children: dict[int, list[int]] = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            fields = (entry / "stat").read_text().rsplit(")", 1)[1].split()
            children.setdefault(int(fields[1]), []).append(int(entry.name))
        except OSError, IndexError, ValueError:
            continue
    found: list[int] = []
    queue = [pid]
    while queue:
        current = queue.pop()
        for child in children.get(current, []):
            found.append(child)
            queue.append(child)
    return found


def cgroup_processes(cgroup: str) -> list[int]:
    root = Path("/sys/fs/cgroup").resolve()
    path = (root / cgroup.lstrip("/")).resolve()
    if path != root and root not in path.parents:
        raise ControlError(f"refusing invalid cgroup path: {cgroup}")
    try:
        return sorted(int(line) for line in (path / "cgroup.procs").read_text().splitlines() if line)
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as error:
        raise ControlError(f"cannot inspect cgroup membership for {cgroup}: {error}") from error


def _validate_scope_members(root: Proc, cgroup: str) -> list[int]:
    members = cgroup_processes(cgroup)
    descendants_of_root = {root.pid, *descendants(root.pid)}
    unexpected = sorted(set(members) - descendants_of_root)
    if root.pid not in members or unexpected:
        raise ControlError(
            f"refusing unexpected Wallpaper Engine scope membership: root={root.pid} "
            f"members={members} unexpected={unexpected}"
        )
    for pid in members:
        try:
            if Path(f"/proc/{pid}").stat().st_uid != os.getuid():
                raise ControlError(f"Wallpaper Engine scope contains foreign-owned PID {pid}")
        except FileNotFoundError:
            continue
    return members


def validated_ux_scope(root: Proc) -> tuple[str, str]:
    if not process_identity_live(root):
        raise ControlError("Wallpaper Engine UX identity changed before its scope could be stopped")
    cgroup = proc_cgroup(root.pid)
    unit = Path(cgroup).name
    if "/app.slice/" not in cgroup or not unit.startswith("app-") or not unit.endswith(f"-{root.pid}.scope"):
        raise ControlError(f"refusing unexpected Wallpaper Engine cgroup: {cgroup}")
    _validate_scope_members(root, cgroup)

    result = run(["systemctl", "--user", "show", unit, "--property=ControlGroup", "--value", "--no-pager"])
    if result.returncode != 0 or result.stdout.strip() != cgroup:
        raise ControlError(f"could not validate Wallpaper Engine systemd scope {unit}")
    if not process_identity_live(root) or proc_cgroup(root.pid) != cgroup:
        raise ControlError("Wallpaper Engine UX identity or cgroup changed during validation")
    _validate_scope_members(root, cgroup)
    return unit, cgroup


def kill_ux(root: Proc) -> None:
    """Kill only a twice-validated Chromium app scope; never guess descendants."""
    unit, cgroup = validated_ux_scope(root)
    result = run(["systemctl", "--user", "kill", "--kill-whom=all", "--signal=KILL", unit])
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or str(result.returncode)
        raise ControlError(f"could not kill validated Wallpaper Engine scope {unit}: {detail}")
    if not wait_until(lambda: not cgroup_processes(cgroup), timeout=3, interval=0.05):
        raise ControlError(f"Wallpaper Engine scope {unit} did not empty: {cgroup_processes(cgroup)}")
    if process_identity_live(root):
        raise ControlError(f"Wallpaper Engine UX PID {root.pid} remained after its scope was killed")


def gpu_memory_used_mib() -> int | None:
    try:
        result = run(["nvidia-smi", "--query-gpu=memory.used", "--format=csv,noheader,nounits"], timeout=3)
        return int(result.stdout.split()[0]) if result.returncode == 0 else None
    except ControlError, ValueError, IndexError:
        return None


def stop() -> dict[str, Any]:
    for helper in helper_windows():
        kill_and_wait(helper["process"], "pause helper")
    ux = ux_processes()
    records = renderers()

    active_config = read_active_config()
    if records:
        active_config = restore_config_for_stop(records, active_config)
    expected = active_screens(active_config)
    if (ux or records) and not selection_is_empty(active_config):
        write_power_state(expected, active_config)
    gpu_before = gpu_memory_used_mib()

    for process in ux:
        kill_ux(process)
    for renderer in records:
        kill_and_wait(renderer, "renderer")
    if not wait_until(lambda: not ux_pids() and not renderers(), timeout=3, interval=0.05):
        raise ControlError(
            f"stop left processes: ux={ux_pids()} renderers={[renderer.pid for renderer in renderers()]}"
        )

    if selection_is_empty(read_active_config()) and not selection_is_empty(active_config):
        write_json_atomic(ACTIVE_WALLPAPERS_PATH, active_config, indent="\t")

    result = snapshot()
    gpu_after = gpu_memory_used_mib()
    if gpu_before is not None and gpu_after is not None:
        result["gpu_memory_released_mib"] = max(0, gpu_before - gpu_after)
    return result


def start() -> dict[str, Any]:
    for helper in helper_windows():
        kill_and_wait(helper["process"], "pause helper")
    ux = ux_processes()
    if renderers() and not ux:
        raise ControlError("orphan Wallpaper Engine renderers are running; stop them before start")
    if len(ux) > 1:
        raise ControlError("multiple Wallpaper Engine UX processes exist; stop before start")

    saved = read_power_state() or {}
    saved_config = saved.get("active_config") if isinstance(saved.get("active_config"), dict) else None
    active_config = read_active_config()
    if selection_is_empty(active_config):
        saved_expected = saved.get("expected_screens")
        if not saved_config or selection_is_empty(saved_config) or not isinstance(saved_expected, list):
            raise ControlError("no trustworthy Wallpaper Engine restore plan exists")
        expected = sorted({str(screen) for screen in saved_expected if screen})
        configured = active_screens(saved_config)
        if not expected or configured != expected:
            raise ControlError(f"saved restore plan is inconsistent: expected={expected} configured={configured}")
        active_config = saved_config
        write_json_atomic(ACTIVE_WALLPAPERS_PATH, active_config, indent="\t")
    else:
        expected = active_screens(active_config)
        if not expected:
            raise ControlError("active Wallpaper Engine selection has no configured outputs")

    shuffled: list[str] = []
    if not ux:
        if not Path(UX_COMMAND).is_file():
            raise ControlError(f"Wallpaper Engine UX is not installed: {UX_COMMAND}")
        shuffled = shuffle_random_playlists(active_playlist_names(active_config))
        RUNTIME_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
        with open(UX_LOG_PATH, "wb") as log:
            subprocess.Popen(
                [UX_COMMAND],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        if not wait_until(lambda: bool(ux_pids()), timeout=15):
            raise ControlError(f"Wallpaper Engine UX did not start; see {UX_LOG_PATH}")

    # Wait until every expected output has a renderer and the set has been stable for 2 s.
    stable_since: float | None = None
    restored: set[str] = set()
    deadline = time.monotonic() + 40
    while time.monotonic() < deadline:
        if not ux_pids():
            raise ControlError(f"Wallpaper Engine UX exited during start; see {UX_LOG_PATH}")
        current = {screen for r in renderers() for screen in r.screens}
        if current != restored:
            restored, stable_since = current, None
        if set(expected) <= restored:
            stable_since = stable_since or time.monotonic()
            if time.monotonic() - stable_since >= 2:
                result = snapshot()
                result["shuffled_playlists"] = shuffled
                return result
        time.sleep(0.2)
    raise ControlError(
        f"Wallpaper Engine did not restore every output: expected={expected} restored={sorted(restored)}"
    )


def power_toggle() -> dict[str, Any]:
    return stop() if ux_pids() or renderers() else start()


# --------------------------------------------------------------------------- status


def snapshot(error: str | None = None) -> dict[str, Any]:
    records = renderers()
    ux = ux_pids()
    helpers = helper_windows()
    screens = sorted({screen for r in records for screen in r.screens})

    problem: str | None = None
    if helpers:
        if not records:
            problem = "pause helper is running without renderers"
        elif not all(h["native_pause"] for h in helpers):
            problem = "pause helper is not fullscreen on its private special workspace"
        elif any("--no-fullscreen-pause" in r.argv or "--fullscreen-pause-only-active" in r.argv for r in records):
            problem = "native fullscreen pausing is disabled for a running renderer"
    if error or problem:
        state = "error"
    elif helpers:
        state = "paused"
    elif records:
        state = "running"
    elif ux:
        state = "idle"
    else:
        state = "stopped"

    result: dict[str, Any] = {
        "state": state,
        "count": len(records),
        "screen_count": len(screens),
        "screens": screens,
        "running": len(records) if state == "running" else 0,
        "paused": len(records) if state == "paused" else 0,
        "pids": [r.pid for r in records],
        "ux_running": bool(ux),
        "ux_pids": ux,
        "power_stopped": not ux and not records and read_power_state() is not None,
        "helper_pid": helpers[0]["pid"] if helpers else None,
        "next_supported": (
            bool(records)
            and any(renderer.playlists or renderer.default_playlist for renderer in records)
            and NEXT_SUPPORT_MARKER.exists()
            and not any(renderer.exe_replaced for renderer in records)
            and all(
                renderer_next_ready(renderer) for renderer in records if renderer.playlists or renderer.default_playlist
            )
        ),
    }
    if error or problem:
        result["error"] = error or problem
    return result


def error_payload(message: str) -> dict[str, Any]:
    return {
        "state": "error",
        "count": 0,
        "screen_count": 0,
        "screens": [],
        "running": 0,
        "paused": 0,
        "pids": [],
        "ux_running": False,
        "ux_pids": [],
        "power_stopped": False,
        "helper_pid": None,
        "next_supported": False,
        "error": message,
    }


@contextmanager
def control_lock() -> Iterator[None]:
    RUNTIME_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def emit(data: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(data, separators=(",", ":")))
        return
    outputs = ", ".join(data["screens"]) or "-"
    print(f"{data['state']}: {data['screen_count']} output(s) on {outputs}; {data['count']} renderer(s)")
    if data.get("error"):
        print(f"error: {data['error']}", file=sys.stderr)


ACTIONS: dict[str, Callable[[], dict[str, Any]]] = {
    "status": snapshot,
    "pause": pause,
    "resume": resume,
    "toggle": toggle,
    "next": next_wallpaper,
    "stop": stop,
    "start": start,
    "power-toggle": power_toggle,
}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("action", nargs="?", default="status", choices=tuple(ACTIONS))
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    args = parser.parse_args()

    try:
        if args.action == "status":
            result = snapshot()
        else:
            with control_lock():
                result = ACTIONS[args.action]()
    except Exception as error:  # noqa: BLE001 - every failure must still produce a status payload
        try:
            result = snapshot(str(error) or type(error).__name__)
        except Exception:  # noqa: BLE001
            result = error_payload(str(error) or type(error).__name__)
        emit(result, args.json)
        return 3

    emit(result, args.json)
    return 2 if result["state"] == "error" else 0


if __name__ == "__main__":
    sys.exit(main())
