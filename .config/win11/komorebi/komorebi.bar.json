{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.bar.json",
  "monitor": {
    "index": 0
  },
  "font_family": "JetBrains Mono",
  "font_size": 15.0,
  "height": 34,
  "margin": 4.0,
  "padding": 4.0,
  "widget_spacing": 8.0,
  "max_label_width": 180.0,
  "frame": {
    "inner_margin": {
      "x": 4.0,
      "y": 2.0
    }
  },
  "grouping": {
    "kind": "Alignment",
    "rounding": 8.0,
    "style": "DefaultWithShadowB4O0S3",
    "transparency_alpha": 225
  },
  "theme": {
    "palette": "Catppuccin",
    "name": "Macchiato",
    "accent": "Blue"
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": false,
          "display": "AllIconsAndText"
        },
        "layout": {
          "enable": true
        },
        "focused_window": {
          "enable": true,
          "show_icon": true
        }
      }
    }
  ],
  "right_widgets": [
    {
      "Update": {
        "enable": true
      }
    },
    {
      "Media": {
        "enable": false
      }
    },
    {
      "Storage": {
        "enable": false
      }
    },
    {
      "Memory": {
        "enable": false
      }
    },
    {
      "Network": {
        "enable": false,
        "show_activity": true,
        "show_total_activity": true
      }
    },
    {
      "Battery": {
        "enable": true
      }
    },
    {
      "Systray": {
        "enable": true
      }
    }
  ],
  "center_widgets": [
    {
      "Date": {
        "enable": true,
        "format": "DayDateMonthYear"
      }
    },
    {
      "Time": {
        "enable": true,
        "format": "TwentyFourHour"
      }
    }
  ]
}
