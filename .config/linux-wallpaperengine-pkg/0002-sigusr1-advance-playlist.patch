 	std::signal (SIGTERM, signalhandler);
 	std::signal (SIGKILL, signalhandler);
+	// SIGUSR1 advances every active playlist by one wallpaper.
+	if (std::signal (SIGUSR1, signalhandler) == SIG_ERR) {
+	    throw std::runtime_error ("Cannot install the SIGUSR1 playlist handler");
+	}
+	if (pthread_sigmask (SIG_UNBLOCK, &advanceMask, nullptr) != 0) {
+	    throw std::runtime_error ("Cannot unblock SIGUSR1 after renderer startup");
+	}
 
