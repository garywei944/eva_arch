@@ -22,6 +24,15 @@ void initLogging () {
 
 int main (int argc, char* argv[]) {
     try {
+	// A renderer becomes discoverable at exec time. Block Next before any
+	// initialization threads exist, then arm the handler before unblocking it.
+	sigset_t advanceMask {};
+	sigemptyset (&advanceMask);
+	sigaddset (&advanceMask, SIGUSR1);
+	if (pthread_sigmask (SIG_BLOCK, &advanceMask, nullptr) != 0) {
+	    throw std::runtime_error ("Cannot block SIGUSR1 during renderer startup");
+	}
+
 	// if type parameter is specified, this is a subprocess, so no logging should be enabled from our side
 	bool enableLogging = true;
 	const std::string typeZygote = "--type=zygote";
