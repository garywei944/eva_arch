export LIBVA_DRIVER_NAME=nvidia
export GBM_BACKEND=nvidia-drm
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __GL_GSYNC_ALLOWED=1

# Let GTK, SDL, and Clutter auto-detect Wayland while retaining XWayland fallback.
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_QPA_PLATFORM='wayland;xcb'
export ELECTRON_OZONE_PLATFORM_HINT=auto

export QT_IM_MODULE=fcitx
export QT_IM_MODULES="wayland;fcitx"

export TERMINAL=kitty

# Cursor size and QT_QPA_PLATFORMTHEME are owned by the DMS dmsThemeSync plugin
# (environment.d/90-dms-theme-sync.conf); do not set them here.
