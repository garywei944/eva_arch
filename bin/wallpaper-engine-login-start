#!/usr/bin/env python3
"""Start Linux Wallpaper Engine once the login session is actually usable.

The Hyprland start edge fires before every output is configured and before the
external Steam library is mounted. Wait for those, then hand lifecycle
ownership to wallpaper-engine-control. One bounded stop/start retry is allowed
if the first start does not bring up every configured output.

The saved selection in active-wallpapers.json cannot be trusted at login: the
Electron UX persists a screen's removal whenever that screen's renderer exits
(crash, GPU reset, or shutdown killing renderers before the UX), so an unlucky
shutdown permanently shrinks it. Instead of restoring the last session, login
rebuilds the selection declaratively: every connected screen in LOGIN_PLAYLISTS
gets its named playlist, and screens outside the declaration are pruned so a
stale entry can never block readiness.

Environment overrides (used by the regression tests):
  WALLPAPER_ENGINE_ACTIVE_CONFIG, WALLPAPER_ENGINE_ASSETS_DIR,
  WALLPAPER_ENGINE_CONTROL, WALLPAPER_ENGINE_HYPRCTL,
  WALLPAPER_ENGINE_RENDERER, WALLPAPER_ENGINE_STEAM_CONFIG,
  WALLPAPER_ENGINE_LOGIN_PLAYLISTS (JSON object mapping screen -> playlist),
  WALLPAPER_ENGINE_READY_TIMEOUT, WALLPAPER_ENGINE_READY_POLL_INTERVAL,
  WALLPAPER_ENGINE_RETRY_DELAY
"""

from __future__ import annotations

import argparse
import fcntl
import json
import math
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

HOME = Path.home()
ACTIVE_CONFIG = Path(
    os.environ.get("WALLPAPER_ENGINE_ACTIVE_CONFIG", HOME / ".config/Linux Wallpaper Engine/active-wallpapers.json")
)
ASSETS_DIR = Path(
    os.environ.get("WALLPAPER_ENGINE_ASSETS_DIR", HOME / ".local/share/Steam/steamapps/common/wallpaper_engine/assets")
)
CONTROL = os.environ.get("WALLPAPER_ENGINE_CONTROL", str(HOME / "bin/wallpaper-engine-control"))
HYPRCTL = os.environ.get("WALLPAPER_ENGINE_HYPRCTL", "hyprctl")
RENDERER = os.environ.get("WALLPAPER_ENGINE_RENDERER", "/usr/bin/linux-wallpaperengine")
SYSTEMCTL = os.environ.get("WALLPAPER_ENGINE_SYSTEMCTL", "systemctl")
STEAM_CONFIG = Path(
    os.environ.get(
        "WALLPAPER_ENGINE_STEAM_CONFIG", HOME / ".local/share/Steam/steamapps/common/wallpaper_engine/config.json"
    )
)
DEFAULT_LOGIN_PLAYLISTS = {"DP-1": "DP-1", "DP-2": "DP-2", "DP-3": "DP-3"}
LOCK_PATH = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "wallpaper-engine-login-start.lock"
START_TIMEOUT = 75  # wallpaper-engine-control start gives up after ~55 s itself
AUDIO_SERVICES = ("pipewire.service", "pipewire-pulse.service", "wireplumber.service")


def env_float(name: str, default: float, minimum: float, allow_minimum: bool = False) -> float:
    raw = os.environ.get(name, str(default))
    try:
        value = float(raw)
    except ValueError as error:
        raise ValueError(f"{name} must be a finite number") from error
    if not math.isfinite(value) or value < minimum or (value == minimum and not allow_minimum):
        comparison = "at least" if allow_minimum else "greater than"
        raise ValueError(f"{name} must be finite and {comparison} {minimum}")
    return value


def login_playlists() -> dict[str, str]:
    raw = os.environ.get("WALLPAPER_ENGINE_LOGIN_PLAYLISTS")
    if raw is None:
        return dict(DEFAULT_LOGIN_PLAYLISTS)
    try:
        mapping = json.loads(raw)
    except json.JSONDecodeError as error:
        raise ValueError("WALLPAPER_ENGINE_LOGIN_PLAYLISTS must be valid JSON") from error
    if not isinstance(mapping, dict) or not mapping:
        raise ValueError("WALLPAPER_ENGINE_LOGIN_PLAYLISTS must be a non-empty JSON object")
    for screen, playlist in mapping.items():
        if not (isinstance(screen, str) and screen and isinstance(playlist, str) and playlist):
            raise ValueError("WALLPAPER_ENGINE_LOGIN_PLAYLISTS must map screen names to playlist names")
    return mapping


def emit(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, separators=(",", ":"), sort_keys=True))


def configured_state() -> tuple[list[str], list[Path], str | None]:
    """Return (expected screens, wallpaper directories, config error)."""
    try:
        config = json.loads(ACTIVE_CONFIG.read_text())
    except FileNotFoundError:
        return [], [], f"active wallpaper configuration is missing: {ACTIVE_CONFIG}"
    except json.JSONDecodeError:
        return [], [], f"active wallpaper configuration is invalid JSON: {ACTIVE_CONFIG}"
    if not isinstance(config, dict):
        return [], [], "active wallpaper configuration must be a JSON object"

    screens: set[str] = set()
    wallpapers: set[Path] = set()
    for key in ("activeWallpapers", "activePlaylists"):
        section = config.get(key)
        if not isinstance(section, dict):
            continue
        for name, record in section.items():
            if not isinstance(record, dict):
                continue
            screen = record.get("screen", name)
            if isinstance(screen, str) and screen:
                screens.add(screen)
            background = record.get("backgroundId")
            if isinstance(background, str) and background:
                wallpapers.add(Path(background))
    legacy = config.get("activePlaylist")
    if isinstance(legacy, dict) and isinstance(legacy.get("screen"), str) and legacy["screen"]:
        screens.add(legacy["screen"])
    return sorted(screens), sorted(wallpapers), None


def steam_playlist_items(name: str) -> list[str]:
    try:
        config = json.loads(STEAM_CONFIG.read_text())
    except OSError, json.JSONDecodeError:
        return []
    if not isinstance(config, dict):
        return []
    for user in config.values():
        general = user.get("general") if isinstance(user, dict) else None
        playlists = general.get("playlists") if isinstance(general, dict) else None
        if not isinstance(playlists, list):
            continue
        for playlist in playlists:
            if isinstance(playlist, dict) and playlist.get("name") == name and isinstance(playlist.get("items"), list):
                return [item for item in playlist["items"] if isinstance(item, str) and item]
    return []


def enforce_login_selection(desired: dict[str, str]) -> list[str]:
    """Force every connected declared screen to run its named playlist.

    Screens whose monitor is not connected are left for the readiness poll to
    retry; screens whose playlist has nothing on disk are left untouched so a
    missing Steam library never wipes a valid selection. Undeclared screens are
    pruned. Returns the screens whose entries were (re)written.
    """
    monitors, monitor_error = available_monitors()
    if monitor_error:
        return []
    existed = True
    try:
        config = json.loads(ACTIVE_CONFIG.read_text())
    except OSError, json.JSONDecodeError:
        config = None
        existed = False
    if not isinstance(config, dict):
        config = {}
    wallpapers = config.get("activeWallpapers")
    playlists = config.get("activePlaylists")
    if not isinstance(wallpapers, dict):
        wallpapers = config["activeWallpapers"] = {}
    if not isinstance(playlists, dict):
        playlists = config["activePlaylists"] = {}
    config.setdefault("activePlaylist", None)
    config.setdefault("appliedHistory", {})

    changed = False
    applied: list[str] = []
    for screen, playlist_name in sorted(desired.items()):
        if screen not in monitors:
            continue
        playlist_entry = playlists.get(screen)
        playlist_matches = (
            isinstance(playlist_entry, dict)
            and playlist_entry.get("name") == playlist_name
            and playlist_entry.get("screen") == screen
        )
        wallpaper_entry = wallpapers.get(screen)
        background = wallpaper_entry.get("backgroundId") if isinstance(wallpaper_entry, dict) else None
        background_available = isinstance(background, str) and Path(background).is_dir()
        if playlist_matches and background_available:
            continue
        if not background_available:
            background = next((item for item in steam_playlist_items(playlist_name) if Path(item).is_dir()), None)
            if background is None:
                continue
        wallpapers[screen] = {"backgroundId": background, "screen": screen}
        playlists[screen] = {"name": playlist_name, "screen": screen}
        changed = True
        applied.append(screen)

    for section in (wallpapers, playlists):
        for name in [name for name in section if name not in desired]:
            del section[name]
            changed = True

    if changed or not existed:
        try:
            temporary = ACTIVE_CONFIG.with_name(f"{ACTIVE_CONFIG.name}.tmp-{os.getpid()}")
            temporary.write_text(json.dumps(config, indent="\t") + "\n")
            os.replace(temporary, ACTIVE_CONFIG)
        except OSError:
            return []
    return applied


def available_monitors() -> tuple[list[str], str | None]:
    try:
        result = subprocess.run([HYPRCTL, "monitors", "-j"], check=False, capture_output=True, text=True, timeout=5)
        monitors = json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError) as error:
        return [], f"hyprctl monitors failed: {error}"
    if not isinstance(monitors, list):
        return [], f"hyprctl monitors failed: exit {result.returncode}"
    return (
        sorted(
            str(record["name"])
            for record in monitors
            if isinstance(record, dict) and record.get("name") and not record.get("disabled", False)
        ),
        None,
    )


def audio_service_states() -> dict[str, str]:
    states: dict[str, str] = {}
    for service in AUDIO_SERVICES:
        try:
            result = subprocess.run(
                [SYSTEMCTL, "--user", "is-active", service],
                check=False,
                capture_output=True,
                text=True,
                timeout=5,
            )
            state = result.stdout.strip() or ("unknown" if result.returncode == 0 else "error")
        except (OSError, subprocess.TimeoutExpired) as error:
            state = f"error: {error}"
        states[service] = state
    return states


def renderer_health() -> tuple[bool, str | None]:
    """Prove the native renderer and its dynamic-library closure can load."""
    try:
        result = subprocess.run(
            [RENDERER, "--help"],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return False, f"renderer preflight failed: {error}"
    if result.returncode == 0:
        return True, None
    detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
    return False, f"renderer preflight failed: {detail[-512:]}"


def readiness_snapshot() -> dict[str, Any]:
    expected, wallpapers, config_error = configured_state()
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "")
    display = os.environ.get("WAYLAND_DISPLAY", "")
    wayland_ready = bool(runtime_dir and display and (Path(runtime_dir) / display).exists())
    monitors, monitor_error = available_monitors()
    audio_services = audio_service_states()
    audio_ready = all(state == "active" for state in audio_services.values())
    renderer_ready, renderer_error = renderer_health()
    missing_screens = sorted(set(expected) - set(monitors))
    missing_wallpapers = sorted(str(path) for path in wallpapers if not path.is_dir())
    assets_ready = ASSETS_DIR.is_dir()
    ready = (
        config_error is None
        and bool(expected)
        and wayland_ready
        and monitor_error is None
        and audio_ready
        and renderer_ready
        and not missing_screens
        and assets_ready
        and not missing_wallpapers
    )
    return {
        "ready": ready,
        "expected_screens": expected,
        "available_screens": monitors,
        "missing_screens": missing_screens,
        "wayland_ready": wayland_ready,
        "assets_ready": assets_ready,
        "assets_dir": str(ASSETS_DIR),
        "missing_wallpaper_paths": missing_wallpapers,
        "config_error": config_error,
        "monitor_error": monitor_error,
        "audio_ready": audio_ready,
        "audio_services": audio_services,
        "renderer_ready": renderer_ready,
        "renderer_error": renderer_error,
    }


def wait_until_ready(timeout: float, poll_interval: float, desired: dict[str, str] | None = None) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    applied: set[str] = set()
    while True:
        if desired is not None:
            applied.update(enforce_login_selection(desired))
        snapshot = readiness_snapshot()
        snapshot["applied_screens"] = sorted(applied)
        # Give declared-but-disconnected screens until the deadline to come up
        # so a slow output does not get started without its wallpaper; a
        # genuinely removed monitor only delays the start, never blocks it.
        pending = set(desired) - set(snapshot["available_screens"]) if desired is not None else set()
        if snapshot["ready"] and not pending:
            return snapshot
        # Enforcement can heal a missing or corrupt config once monitors appear,
        # so only a broken renderer is unrecoverable before the deadline.
        if (snapshot["config_error"] and desired is None) or snapshot["renderer_error"]:
            return snapshot
        if time.monotonic() >= deadline:
            return snapshot
        time.sleep(poll_interval)


def invoke_control(action: str) -> tuple[int, dict[str, Any]]:
    try:
        result = subprocess.run(
            [CONTROL, action, "--json"], check=False, capture_output=True, text=True, timeout=START_TIMEOUT
        )
        payload = json.loads(result.stdout)
    except (OSError, subprocess.TimeoutExpired) as error:
        return 127, {"state": "error", "error": str(error)}
    except json.JSONDecodeError:
        return result.returncode, {"state": "error", "error": "wallpaper-engine-control returned invalid JSON"}
    if not isinstance(payload, dict):
        return result.returncode, {"state": "error", "error": "wallpaper-engine-control returned an unexpected payload"}
    return result.returncode, payload


def running_matches(payload: dict[str, Any], expected_screens: list[str]) -> bool:
    # Compare outputs only: one renderer may serve several screens (--screen-root per screen, or --screen-span).
    screens = payload.get("screens")
    return (
        payload.get("state") == "running"
        and not payload.get("error")
        and payload.get("ux_running") is True
        and isinstance(screens, list)
        and set(expected_screens) <= {str(screen) for screen in screens}
    )


def login_start(
    timeout: float, poll_interval: float, retry_delay: float, desired: dict[str, str]
) -> tuple[int, dict[str, Any]]:
    readiness = wait_until_ready(timeout, poll_interval, desired=desired)
    if not readiness["ready"]:
        return 3, {
            "state": "error",
            "step": "readiness",
            "attempts": 0,
            "error": "login prerequisites did not become ready before the deadline",
            "readiness": readiness,
        }
    expected = readiness["expected_screens"]
    applied = readiness.get("applied_screens", [])

    code = 0
    payload: dict[str, Any] = {}
    for attempt in (1, 2):
        code, payload = invoke_control("start")
        if code == 0 and running_matches(payload, expected):
            return 0, {**payload, "attempts": attempt, "applied_screens": applied, "login_start": "ready"}
        if attempt == 1:
            stop_code, stop_payload = invoke_control("stop")
            if stop_code != 0 or stop_payload.get("state") not in {"stopped", "error"}:
                return 3, {
                    "state": "error",
                    "step": "retry-cleanup",
                    "attempts": 1,
                    "error": "cleanup failed after the first start attempt",
                    "controller_state": stop_payload.get("state"),
                }
            time.sleep(retry_delay)
            readiness = wait_until_ready(timeout, poll_interval, desired=desired)
            if not readiness["ready"]:
                return 3, {
                    "state": "error",
                    "step": "retry-readiness",
                    "attempts": 1,
                    "error": "login prerequisites disappeared before the retry",
                    "readiness": readiness,
                }
            expected = readiness["expected_screens"]
            applied = sorted(set(applied) | set(readiness.get("applied_screens", [])))
    return 3, {
        "state": "error",
        "step": "start",
        "attempts": 2,
        "error": "Wallpaper Engine did not restore every configured output after one retry",
        "controller_exit": code,
        "controller_state": payload.get("state"),
        "controller_error": payload.get("error"),
        "controller_screens": payload.get("screens", []),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--check", action="store_true", help="report readiness without starting anything")
    args = parser.parse_args()

    descriptor: int | None = None
    try:
        if args.check:
            payload = readiness_snapshot()
            emit(payload)
            return 0 if payload["ready"] else 1

        timeout = env_float("WALLPAPER_ENGINE_READY_TIMEOUT", 90.0, 0.0)
        poll_interval = env_float("WALLPAPER_ENGINE_READY_POLL_INTERVAL", 0.5, 0.0)
        retry_delay = env_float("WALLPAPER_ENGINE_RETRY_DELAY", 2.0, 0.0, allow_minimum=True)
        desired = login_playlists()

        LOCK_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        descriptor = os.open(
            LOCK_PATH,
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
            0o600,
        )
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            emit(
                {
                    "state": "error",
                    "step": "setup",
                    "attempts": 0,
                    "error": "another login start is already running",
                }
            )
            return 3

        code, payload = login_start(
            timeout=timeout, poll_interval=poll_interval, retry_delay=retry_delay, desired=desired
        )
        emit(payload)
        return code
    except Exception as error:  # noqa: BLE001 - setup failures must preserve the JSON contract
        emit(
            {
                "state": "error",
                "step": "setup",
                "attempts": 0,
                "error": str(error) or type(error).__name__,
            }
        )
        return 3
    finally:
        if descriptor is not None:
            os.close(descriptor)


if __name__ == "__main__":
    sys.exit(main())
